# Claims Data Ingestion Pipeline - Environment Configuration

# Database Configuration
# Defaults to local SQLite for instant out-of-the-box execution:
DATABASE_URL=sqlite:///./data/claims_ingestion.db
# Or connect directly to PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claims_db

# File Storage Directory
STORAGE_DIR=./storage
SAMPLE_DATA_DIR=./sample_data

# Validation Settings
AMOUNT_TOLERANCE=0.05
MAX_FILE_SIZE_BYTES=52428800
